{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        

        
        {
            "name": "metal",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug"
        },
        {
            "name": "metal (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "metal (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },

        {
            "name": "production",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod",
                "--target",
                "lib/main.dart"
            ]
        },
        {
            "name": "dev",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "args": [
                "--flavor",
                "dev",
                "--target",
                "lib/main_dev.dart"
        ]
},
    ]
}